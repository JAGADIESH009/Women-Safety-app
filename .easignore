# Root .easignore for monorepo EAS builds

# Non-mobile workspaces
backend/
frontend/admin/
frontend/public-web/
database/
deployment/
docker/
docs/
tests/
.git/
.agents/
.pytest_cache/
.vercel/

# Environments
.env
.env.*
!.env.example

# Node
node_modules/
npm-debug.log
yarn-error.log

# Python
__pycache__/
*.py[cod]
venv/
env/

# Android build caches and intermediate build files
frontend/mobile/android/.gradle/
frontend/mobile/android/app/build/
frontend/mobile/android/build/
frontend/mobile/android/.idea/
android/.gradle/
android/app/build/
android/build/
.gradle/
build/

# Expo / React Native
.expo/
dist/
web-build/
*.jks
*.keystore
*.apk
frontend/mobile/latest.apk

# Temp & testing files
.playwright-cli/
*.db
*.sqlite3
*.b64
adb_full_dump.txt
dumpsys.txt
sos_logcat.txt
*.html
*.mjs
*.log
/*_screen*.png
/running_app*.png
frontend/mobile/*_screen*.png
frontend/mobile/running_app*.png

# Explicitly keep mobile assets and Android native resources
!frontend/mobile/assets/**
!frontend/mobile/android/app/src/main/res/**
!frontend/mobile/google-services.json
